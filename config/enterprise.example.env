# Copy to an ignored .env file or export these before using infra/compose/enterprise.yml.
ROBOBOY_ENTERPRISE_ORIGIN=https://robots.example.com
ROBOBOY_ENTERPRISE_LOGIN=true
# Configure any combination of company OIDC, Google and Microsoft. The login screen shows one
# button per provider. Every provider uses the callback https://<origin>/auth/callback.
# Use a tenant-specific issuer, not an unrestricted multi-tenant endpoint.
ROBOBOY_OIDC_ISSUER=https://identity.example.com/realms/company
ROBOBOY_OIDC_CLIENT_ID=robo-boy
ROBOBOY_OIDC_CLIENT_SECRET_FILE=./.secrets/oidc-client-secret
# Optional required group. The verified ID token claim is checked first, then userinfo.
# Keycloak full paths such as /robot-operators also match robot-operators.
ROBOBOY_OIDC_REQUIRED_GROUP=robot-operators
# Claim holding groups or roles, for example roles for Entra ID app roles.
# ROBOBOY_OIDC_GROUPS_CLAIM=groups
# Add groups for Okta's groups claim.
# ROBOBOY_OIDC_SCOPE=openid profile email
# select_account (default), login, consent, or off to send no prompt.
# ROBOBOY_OIDC_PROMPT=select_account
# Button text after "Sign in with"; defaults to "your company account".
# ROBOBOY_OIDC_LABEL=Acme SSO

# Optional Google sign-in. Restrict it: any Google account can otherwise sign in.
# Domains are Google Workspace domains (verified hd claim); emails must be verified.
# ROBOBOY_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# ROBOBOY_GOOGLE_CLIENT_SECRET_FILE=./.secrets/google-client-secret
# ROBOBOY_GOOGLE_ALLOWED_DOMAINS=example.com
# ROBOBOY_GOOGLE_ALLOWED_EMAILS=contractor@gmail.com

# Optional Microsoft Entra ID sign-in, limited to one directory (tenant) ID.
# ROBOBOY_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ROBOBOY_MICROSOFT_CLIENT_SECRET_FILE=./.secrets/microsoft-client-secret
# ROBOBOY_MICROSOFT_TENANT=00000000-0000-0000-0000-000000000000
# ROBOBOY_MICROSOFT_REQUIRED_ROLE=Robot.Operator
ROBOBOY_AUTH_SESSION_SECONDS=3600
# Standalone Node gateway: set a path in a private, writable directory for restart recovery.
# The enterprise Compose overlay already configures this on its persistent enterprise-sessions volume.
# ROBOBOY_AUTH_SESSION_FILE=/var/lib/roboboy-auth/sessions.json
ROBOBOY_BRANDING_FILE=config/branding.example.json

# Optional server-owned fleet registry; an empty list preserves the single-robot workflow.
# ROBOBOY_ROBOTS_FILE=./config/robots.example.json
