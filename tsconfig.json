{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* Added for React JSX */
    "jsxImportSource": "react",
    /* Type-check against the web stub so the desktop-only HTTP package is not required to
       build the web app; Vite resolves the real package for the tauri build. */
    "baseUrl": ".",
    "paths": {
      "@tauri-apps/plugin-http": ["src/panels/nativeHttpFetch.web.ts"],
      "@tauri-apps/api/window": ["src/runtime/nativeWindow.web.ts"]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./config/tsconfig.node.json"
    }
  ]
}
