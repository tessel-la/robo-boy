FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
# Keep in sync with gateway.mjs's local imports; gateway.test.mjs checks this list.
COPY infra/enterprise/gateway.mjs infra/enterprise/config.mjs infra/enterprise/providers.mjs ./infra/enterprise/
USER node
CMD ["node", "infra/enterprise/gateway.mjs"]
