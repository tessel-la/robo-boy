# Default development entry point. Enterprise uses the same routes behind authentication.
{
    debug
    storage file_system /data/caddy_storage
}
import /etc/caddy/Routes.caddy
:{$HTTPS_PORT:443} {
    tls /etc/caddy/certs/local-cert.pem /etc/caddy/certs/local-key.pem
    log {
        output stdout
    }
    import roboboy_routes
}
:{$HTTP_PORT:80} {
    log {
        output stdout
    }
    import roboboy_routes
}
