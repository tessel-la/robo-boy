# Caddyfile - Using mkcert
{
	debug
	storage file_system /data/caddy_storage
}

# Listen on 443, serve both localhost and IP using mkcert files
:{$HTTPS_PORT:443} {
	# Point to the mounted mkcert certificate and key
	tls /etc/caddy/certs/local-cert.pem /etc/caddy/certs/local-key.pem

	log {
		output stdout
	}

	# Order matters: More specific handlers first

	handle /api/panels* {
		reverse_proxy http://panel-manager:4100
	}

	# Route WebSocket requests to the ros-stack container
	handle /websocket* {
		uri strip_prefix /websocket
		reverse_proxy {$BACKEND_HOST:host.docker.internal}:{$ROSBRIDGE_PORT:9090}
	}

	# Route video stream requests to the ros-stack container
	handle /video_stream* {
		uri strip_prefix /video_stream
		reverse_proxy {$BACKEND_HOST:host.docker.internal}:{$VIDEO_STREAM_PORT:8080}
	}

	# MediaMTX WebRTC/WHEP signaling. WebRTC media is negotiated separately
	# over the gateway's advertised ICE port (UDP 8189 by default).
	handle /webrtc* {
		uri strip_prefix /webrtc
		reverse_proxy unix//run/webrtc-relay/webrtc.sock {
			# MediaMTX returns an origin-relative WHEP session URL. Restore the
			# public prefix so the panel's DELETE cleanup reaches this handler.
			header_down Location ^/(.*)$ /webrtc/$1
		}
	}

	# Proxy mesh resources to the configured backend. The backend owns the
	# active robot assets; Robo Boy remains independent of robot and simulator.
	handle_path /mesh_resources/* {
		reverse_proxy {$BACKEND_HOST:host.docker.internal}:{$MESH_RESOURCES_PORT:8000}
	}

	# Keep the read/chat Ollama endpoints same-origin without exposing its
	# model-management API through the public web proxy.
	@ollama_api path /ollama/api/tags /ollama/api/chat
	handle @ollama_api {
		uri strip_prefix /ollama
		reverse_proxy unix//run/ollama-relay/ollama.sock
	}

	# Route other requests to the Vite app container (Default Handler)
	handle {
		# Still proxy to HTTP endpoint of Vite container
		reverse_proxy http://app:{$FRONTEND_PORT:5173}
	}
}

# HTTP port 80 - serve content directly without redirect
:{$HTTP_PORT:80} {
	log {
		output stdout
	}

	# Order matters: More specific handlers first

	handle /api/panels* {
		reverse_proxy http://panel-manager:4100
	}

	# Route WebSocket requests to the ros-stack container
	handle /websocket* {
		uri strip_prefix /websocket
		reverse_proxy {$BACKEND_HOST:host.docker.internal}:{$ROSBRIDGE_PORT:9090}
	}

	# Route video stream requests to the ros-stack container
	handle /video_stream* {
		uri strip_prefix /video_stream
		reverse_proxy {$BACKEND_HOST:host.docker.internal}:{$VIDEO_STREAM_PORT:8080}
	}

	# Proxy WHEP signaling to the backend media gateway.
	handle /webrtc* {
		uri strip_prefix /webrtc
		reverse_proxy unix//run/webrtc-relay/webrtc.sock {
			header_down Location ^/(.*)$ /webrtc/$1
		}
	}

	# Proxy mesh resources to the configured robot backend.
	handle_path /mesh_resources/* {
		reverse_proxy {$BACKEND_HOST:host.docker.internal}:{$MESH_RESOURCES_PORT:8000}
	}

	# Proxy only the Ollama endpoints used by the BT agent.
	@ollama_api path /ollama/api/tags /ollama/api/chat
	handle @ollama_api {
		uri strip_prefix /ollama
		reverse_proxy unix//run/ollama-relay/ollama.sock
	}

	# Route other requests to the Vite app container (Default Handler)
	handle {
		# Still proxy to HTTP endpoint of Vite container
		reverse_proxy http://app:{$FRONTEND_PORT:5173}
	}
}

# Removed the duplicate localhost block
