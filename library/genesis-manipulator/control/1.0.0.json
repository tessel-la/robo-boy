    {
      "id": "pad/genesis-control",
      "kind": "pad",
      "formatVersion": 1,
      "data": {
        "id": "genesis-control-pad",
        "name": "Genesis Control",
        "description": "Control Genesis robot with two joysticks for linear and angular motion.",
        "components": [
          {
            "id": "linear-joystick",
            "type": "joystick",
            "position": {
              "x": 0,
              "y": 1,
              "width": 3,
              "height": 3
            },
            "label": "Linear Motion",
            "action": {
              "topic": "/arm_1/servo_node/delta_twist_cmds",
              "messageType": "geometry_msgs/msg/TwistStamped",
              "field": "twist"
            },
            "config": {
              "min": -1,
              "max": 1,
              "axes": [
                "linear.x",
                "linear.y"
              ],
              "axisScales": [
                1,
                1
              ],
              "sliderMin": -1,
              "sliderMax": 1
            }
          },
          {
            "id": "angular-joystick",
            "type": "joystick",
            "position": {
              "x": 5,
              "y": 1,
              "width": 3,
              "height": 3
            },
            "label": "Angular Motion",
            "action": {
              "topic": "/arm_1/servo_node/delta_twist_cmds",
              "messageType": "geometry_msgs/msg/TwistStamped",
              "field": "twist"
            },
            "config": {
              "min": -1,
              "max": 1,
              "axes": [
                "angular.x",
                "angular.y"
              ],
              "axisScales": [
                1,
                1
              ]
            }
          },
          {
            "id": "linear-z-joystick",
            "type": "joystick",
            "position": {
              "x": 3,
              "y": 1,
              "width": 2,
              "height": 3
            },
            "label": "Linear Z",
            "action": {
              "topic": "/arm_1/servo_node/delta_twist_cmds",
              "messageType": "geometry_msgs/msg/TwistStamped",
              "field": "twist"
            },
            "config": {
              "min": -1,
              "max": 1,
              "axes": [
                "linear.z"
              ],
              "axisScales": [
                1
              ],
              "sliderMin": -1,
              "sliderMax": 1
            }
          }
        ],
        "gridSize": {
          "width": 8,
          "height": 4
        },
        "cellSize": 80,
        "rosConfig": {
          "defaultTopic": "/arm_1/servo_node/delta_twist_cmds",
          "defaultMessageType": "geometry_msgs/msg/TwistStamped"
        },
        "metadata": {
          "created": "2026-01-01T00:00:00.000Z",
          "modified": "2026-09-09T19:59:03.116Z",
          "version": "1.0.0"
        }
      }
    },
    {
      "id": "bt/move-xy",
      "kind": "behaviorTree",
      "formatVersion": 1,
      "data": {
        "id": "2c99041f-0ed5-4f64-9eb9-4555fe355bbb",
        "name": "Move Genesis X Y",
        "description": "Publishes one TwistStamped command with linear X/Y velocities of 0.1 m/s to the Genesis servo topic. This is a velocity command, not a 0.1 m displacement. Review frame and timestamp requirements before running.",
        "createdAt": 1789079576895,
        "updatedAt": 1789079578366,
        "blackboardDefaults": {},
        "nodes": [
          {
            "id": "move-genesis-xy-01",
            "type": "topic",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "label": "Publish X/Y twist (0.1 m/s)",
              "topicName": "/arm_1/servo_node/delta_twist_cmds",
              "messageType": "geometry_msgs/msg/TwistStamped",
              "message": {
                "header": {
                  "stamp": {
                    "sec": 0,
                    "nanosec": 0
                  },
                  "frame_id": ""
                },
                "twist": {
                  "linear": {
                    "x": 0.1,
                    "y": 0.1,
                    "z": 0
                  },
                  "angular": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              },
              "publishOnce": true,
              "inputBindings": []
            }
          }
        ],
        "edges": []
      }
    },
